<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom Sheet layout for the settings panel.
    Now includes System-wide and Other Apps ad blocking toggles and shortcuts.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorSurface"
    android:orientation="vertical"
    android:paddingStart="@dimen/sheet_padding"
    android:paddingEnd="@dimen/sheet_padding"
    android:paddingTop="@dimen/sheet_padding"
    android:paddingBottom="24dp">

    <!-- Drag handle indicator (visual only) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/colorDragHandle"
        android:backgroundTint="@color/colorDragHandle" />

    <!-- Sheet title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/settings_title"
        android:textColor="@color/colorOnSurface"
        android:textSize="20sp" />

    <!-- Toggle Row: Block Ads (YouTube) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toggle_block_ads"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toggle_block_ads_desc"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchBlockAds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/colorPrimary"
            app:trackTint="@color/colorTrack" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorDivider" />

    <!-- Toggle Row: Hide Shorts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toggle_block_shorts"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toggle_block_shorts_desc"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchBlockShorts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/colorPrimary"
            app:trackTint="@color/colorTrack" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorDivider" />

    <!-- Toggle Row: Background Play -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toggle_background_play"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toggle_background_play_desc"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchBackgroundPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/colorPrimary"
            app:trackTint="@color/colorTrack" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorDivider" />

    <!-- Toggle Row: Block Ads in All Apps & System (VPN) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toggle_block_system_ads"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toggle_block_system_ads_desc"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchBlockSystemAds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/colorPrimary"
            app:trackTint="@color/colorTrack" />
    </LinearLayout>

    <!-- Alternative zero-battery Private DNS button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonPrivateDns"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_private_dns_setup"
        android:textColor="@color/colorOnSurface"
        app:strokeColor="@color/colorDivider" />

    <!-- Done button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonDone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/colorPrimary"
        android:text="@string/done"
        android:textColor="@color/colorOnPrimary" />

</LinearLayout>
